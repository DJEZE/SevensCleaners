# ── Clerk (Authentication) ────────────────────────────────────────────────────
# https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Supabase (Database + Storage) ────────────────────────────────────────────
# https://supabase.com → Project → Settings → Database
DATABASE_URL=
DIRECT_URL=
# https://supabase.com → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Square (Payments) ─────────────────────────────────────────────────────────
# https://developer.squareup.com → Applications → your app
NEXT_PUBLIC_SQUARE_APP_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_WEBHOOK_SIGNATURE_KEY=

# ── Twilio (SMS) ──────────────────────────────────────────────────────────────
# https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── SendGrid (Email) ──────────────────────────────────────────────────────────
# https://app.sendgrid.com → Settings → API Keys
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# ── Google Maps ───────────────────────────────────────────────────────────────
# https://console.cloud.google.com → APIs & Services → Credentials
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
ADMIN_EMAIL=your@email.com
