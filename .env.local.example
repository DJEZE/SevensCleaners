# ── Clerk (Authentication) ────────────────────────────────────────────────────
# https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Supabase (Database + Storage) ────────────────────────────────────────────
# https://supabase.com → Project → Settings → Database
DATABASE_URL=
DIRECT_URL=
# https://supabase.com → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (Payments) ─────────────────────────────────────────────────────────
# https://dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
# https://dashboard.stripe.com → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Twilio (SMS) ──────────────────────────────────────────────────────────────
# https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Resend (Email) ────────────────────────────────────────────────────────────
# https://resend.com → API Keys
RESEND_API_KEY=re_...
# Must be a verified domain in Resend, e.g. "Sevens Cleaners <no-reply@yourdomain.com>"
RESEND_FROM_EMAIL=Sevens Cleaners <no-reply@yourdomain.com>

# ── Google Maps ───────────────────────────────────────────────────────────────
# https://console.cloud.google.com → APIs & Services → Credentials
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
ADMIN_EMAIL=your@email.com
